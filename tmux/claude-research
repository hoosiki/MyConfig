#!/usr/bin/env bash
# =============================================================================
#  claude-research — tmuxp 기반 ClaudeResearches 세션 런처
#
#  Usage:
#    claude-research              # 세션 생성 또는 기존 세션에 attach
#    claude-research -d           # detached 모드 (백그라운드 생성)
#    claude-research -k           # 기존 세션 종료 후 새로 생성
#    claude-research -R           # Remote Control 이름 주입 없이 YAML 그대로 로드
#    claude-research --dry-run    # --rc 주입 결과만 diff로 출력 (세션 생성 안 함)
#
#  로드 전에 각 윈도우의 Claude Code pane 명령 끝에 `--rc '<window_name>'`을 덧붙인
#  임시 YAML을 만들어 사용한다. Remote Control이 세션 시작과 함께 켜지고, claude.ai/code
#  에 표시되는 세션 이름이 tmux 윈도우 이름과 같아진다.
# =============================================================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
YAML_CONFIG="${SCRIPT_DIR}/tmux_init.yaml"
SESSION_NAME="claude-research"

# ── Color helpers ──────────────────────────────────────────────────────────
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

info()  { echo -e "${GREEN}[INFO]${NC} $*"; }
warn()  { echo -e "${YELLOW}[WARN]${NC} $*"; }
error() { echo -e "${RED}[ERROR]${NC} $*" >&2; }

# ── Argument parsing ──────────────────────────────────────────────────────
DETACHED=false
KILL_FIRST=false
USE_RC=true
DRY_RUN=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        -d|--detached) DETACHED=true; shift ;;
        -k|--kill)     KILL_FIRST=true; shift ;;
        -R|--no-rc)    USE_RC=false; shift ;;
        --dry-run)     DRY_RUN=true; shift ;;
        -h|--help)
            echo "Usage: $(basename "$0") [-d|--detached] [-k|--kill] [-R|--no-rc] [--dry-run] [-h|--help]"
            echo ""
            echo "Options:"
            echo "  -d, --detached   세션을 백그라운드에서 생성 (attach 하지 않음)"
            echo "  -k, --kill       기존 세션 종료 후 새로 생성"
            echo "  -R, --no-rc      Claude pane 명령에 --rc <window_name> 을 주입하지 않음"
            echo "  --dry-run        --rc 주입 결과를 diff로 출력하고 종료 (세션 생성 안 함)"
            echo "  -h, --help       도움말"
            exit 0
            ;;
        *) error "Unknown option: $1"; exit 1 ;;
    esac
done

# ── Prerequisite checks ──────────────────────────────────────────────────
if ! command -v tmux &>/dev/null; then
    error "tmux가 설치되어 있지 않습니다. brew install tmux"
    exit 1
fi

if ! command -v tmuxp &>/dev/null; then
    # uv 환경의 tmuxp 확인
    if command -v uv &>/dev/null; then
        TMUXP_CMD="uv run tmuxp"
        if ! $TMUXP_CMD --version &>/dev/null; then
            error "tmuxp가 설치되어 있지 않습니다. uv pip install tmuxp"
            exit 1
        fi
    else
        error "tmuxp가 설치되어 있지 않습니다."
        exit 1
    fi
else
    TMUXP_CMD="tmuxp"
fi

if [[ ! -f "$YAML_CONFIG" ]]; then
    error "YAML 설정 파일을 찾을 수 없습니다: ${YAML_CONFIG}"
    exit 1
fi

# ── Remote Control 이름 주입 ──────────────────────────────────────────────
# tmux_init.yaml의 Claude Code pane 명령(`- claude ...` 또는 `shell_command: claude ...`)
# 끝에 `--rc '<window_name>'`을 덧붙인 YAML을 생성한다. `claude --rc <name>`은 세션
# 시작 시점에 Remote Control을 켜므로 `/rc` 슬래시 명령의 대화형 패널(continue /
# disconnect)이 뜨지 않고, claude.ai/code 목록의 세션 이름이 tmux 윈도우 이름과 같아진다.
#
# 규칙:
#   - 각 윈도우 항목에서 `window_name:`이 `panes:`보다 먼저 와야 한다.
#     (window_name 없이 claude 명령을 만나면 경고만 내고 그대로 둔다)
#   - 이미 --rc / --remote-control 이 있는 명령은 건드리지 않는다.
#   - 따옴표로 감싼 명령 문자열(- "claude ...")은 지원하지 않는다.
#   - 이름 속의 작은따옴표는 셸용으로 이스케이프(' → '\'')한다.
render_rc_yaml() {
    local src="$1" dst="$2"
    awk '
        BEGIN { q = "\047"; name = ""; win_ws = -1 }
        {
            # 현재 줄의 들여쓰기(공백 수)
            match($0, /^[[:space:]]*/); ws = RLENGTH
            # 윈도우 목록의 새 항목(- ...)이 시작되면 이전 window_name 을 버린다
            if (win_ws >= 0 && ws == win_ws && substr($0, ws + 1, 1) == "-") name = ""
        }
        /^[[:space:]]*(-[[:space:]]+)?window_name:/ {
            name = $0
            sub(/^[[:space:]]*(-[[:space:]]+)?window_name:[[:space:]]*/, "", name)
            sub(/[[:space:]]+#.*$/, "", name)          # 인라인 주석 제거
            sub(/[[:space:]]+$/, "", name)
            if (name ~ /^".*"$/ || name ~ ("^" q ".*" q "$")) name = substr(name, 2, length(name) - 2)
            # 이 윈도우 항목의 "- " 들여쓰기를 기억 (window_name 이 첫 키가 아닐 수도 있음)
            win_ws = (substr($0, ws + 1, 1) == "-") ? ws : ws - 2
            print; next
        }
        /^[[:space:]]*(-[[:space:]]+)?(shell_command:[[:space:]]+)?claude([[:space:]]|$)/ &&
        $0 !~ /--rc([[:space:]=]|$)/ && $0 !~ /--remote-control([[:space:]=]|$)/ {
            if (name == "") {
                print "[WARN] window_name 을 알 수 없어 --rc 를 주입하지 않음: " $0 > "/dev/stderr"
                print; next
            }
            n = name
            gsub(/\047/, "\047\\\047\047", n)          # 작은따옴표 이스케이프
            comment = ""
            if (match($0, /[[:space:]]+#.*$/)) {        # 명령 뒤 인라인 주석 보존
                comment = substr($0, RSTART)
                $0 = substr($0, 1, RSTART - 1)
            }
            sub(/[[:space:]]+$/, "")
            print $0 " --rc " q n q comment
            next
        }
        { print }
    ' "$src" > "$dst"
}

if $DRY_RUN; then
    DRY_YAML="$(mktemp "${TMPDIR:-/tmp}/claude-research.XXXXXX")"
    render_rc_yaml "$YAML_CONFIG" "$DRY_YAML"
    info "dry-run: --rc 주입 결과 (원본 대비 diff, 세션은 생성하지 않음)"
    diff -u "$YAML_CONFIG" "$DRY_YAML" || true
    rm -f "$DRY_YAML"
    exit 0
fi

# ── Kill existing session if requested ────────────────────────────────────
if $KILL_FIRST && tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
    warn "기존 세션 '${SESSION_NAME}' 종료 중..."
    tmux kill-session -t "$SESSION_NAME"
    info "기존 세션 종료 완료"
fi

# ── Launch or attach ──────────────────────────────────────────────────────
if tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
    info "기존 세션 '${SESSION_NAME}' 발견 — attach 합니다"
    if [[ -z "${TMUX:-}" ]]; then
        tmux attach-session -t "$SESSION_NAME"
    else
        warn "이미 tmux 내부에 있습니다. switch-client로 전환합니다"
        tmux switch-client -t "$SESSION_NAME"
    fi
else
    info "새 세션 '${SESSION_NAME}' 생성 중..."

    # --rc <window_name> 을 주입한 임시 YAML을 원본과 같은 디렉터리에 만든다.
    # (tmuxp 는 상대 start_directory 를 YAML 파일 위치 기준으로 해석하므로 /tmp 에 두면 안 됨)
    LOAD_YAML="$YAML_CONFIG"
    RENDERED_YAML=""
    if $USE_RC; then
        RENDERED_YAML="${YAML_CONFIG%/*}/.tmux_init.rc-$$.yaml"
        trap 'rm -f "$RENDERED_YAML"' EXIT
        render_rc_yaml "$YAML_CONFIG" "$RENDERED_YAML"
        LOAD_YAML="$RENDERED_YAML"
        info "Claude pane 명령에 --rc <window_name> 주입 완료 (끄려면 -R)"
    fi

    # 항상 detached로 먼저 로드 (post-launch 명령 전송을 위해)
    $TMUXP_CMD load -d -y "$LOAD_YAML"
    if [[ -n "$RENDERED_YAML" ]]; then
        rm -f "$RENDERED_YAML"
    fi

    # ── Post-launch: Claude 기동 후 /sc:load 전송 ────────────────────────
    # claude CLI가 완전히 기동될 때까지 대기한 뒤
    # 각 윈도우의 1번째 pane에 /sc:load 명령어를 전송
    CLAUDE_WAIT_SEC=5
    info "Claude CLI 기동 대기 중... (${CLAUDE_WAIT_SEC}초)"
    sleep "$CLAUDE_WAIT_SEC"

    for win_idx in $(tmux list-windows -t "$SESSION_NAME" -F '#{window_index}'); do
        tmux send-keys -t "${SESSION_NAME}:${win_idx}.1" '/sc:load' Enter
        info "  → ${SESSION_NAME}:${win_idx}.1 에 /sc:load 전송 완료"
    done

    # detached 모드가 아니면 세션에 attach
    if $DETACHED; then
        info "세션이 백그라운드에서 생성되었습니다. tmux attach -t ${SESSION_NAME}"
    elif [[ -z "${TMUX:-}" ]]; then
        tmux attach-session -t "$SESSION_NAME"
    else
        warn "이미 tmux 내부에 있습니다. switch-client로 전환합니다"
        tmux switch-client -t "$SESSION_NAME"
    fi
fi
